# KG4VD environment.
# Copy to `.env` and `set -a && source .env && set +a` before `kg4vd build` / query.

# LLM provider for extract / reflect / align / augment / answer generation
# (default recipe uses OpenRouter's gpt-4o-mini). Only the key for the provider
# you actually use needs to be set.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Optional: Qwen3-VL reranker service URL (query path). Defaults to
# http://127.0.0.1:8003; the query path auto-launches it (scripts/launch_reranker.sh).
# KG4VD_RERANKER_URL=http://127.0.0.1:8003

# MinerU 3.x runs out-of-process in its own conda env; point at that env's
# python so the ingest stage can shell out to services/mineru/run.py.
MINERU_PYTHON=/media/ai2lab/storage1/miniconda3/envs/mineru/bin/python

# Optional: GPU for the GME-Qwen2-VL encoder during the embed stage.
# CUDA_VISIBLE_DEVICES=0

# Optional: log verbosity (DEBUG / INFO / WARNING).
# KG4VD_LOG=INFO
